# leasing-agent secrets. Copy to .env and fill in. .env is gitignored.
# Fleet rule: secrets live here, never in config.json, never in git.

# Telegram — create the bot with botsmith, which prints both values:
#   ~/Desktop/botsmith/botsmith.py new leasing-agent
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Zillow and HotPads answer datacenter IPs with a PerimeterX
# captcha, so those two sources stay disabled until a scraping proxy key is
# present. Everything else (Redfin, Craigslist) works without this.
# Set the key here, then flip sources.zillow to true in config.json.
SCRAPER_API_KEY=

# Optional: which botsmith registry entry to fall back to on scootpc.
# BOTSMITH_NAME=leasing-agent
